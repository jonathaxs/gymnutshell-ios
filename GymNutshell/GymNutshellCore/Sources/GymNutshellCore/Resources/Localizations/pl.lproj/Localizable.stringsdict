			<string>%2$d dnia</string>
		</dict>
	</dict>
	<key>a11y.watch.recent.summary.format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@: %2$#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d dzień z osiągnięciem na 7.</string>
			<key>few</key>
			<string>%2$d dni z osiągnięciami na 7.</string>
			<key>many</key>
			<string>%2$d dni z osiągnięciami na 7.</string>
			<key>other</key>
			<string>%2$d dnia z osiągnięciami na 7.</string>
		</dict>
	</dict>
