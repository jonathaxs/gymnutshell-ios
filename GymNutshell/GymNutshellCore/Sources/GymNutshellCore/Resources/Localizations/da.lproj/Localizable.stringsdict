<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>statistics.tier.days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d dag</string>
			<key>other</key>
			<string>%d dage</string>
		</dict>
	</dict>
	<key>statistics.goals.active</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@goals@</string>
		<key>goals</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d aktivt</string>
			<key>other</key>
			<string>%d aktive</string>
		</dict>
	</dict>
	<key>today.category.a11y.value</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$d af %2$#@goals@</string>
		<key>goals</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d mål fuldført</string>
			<key>other</key>
			<string>%2$d mål fuldført</string>
		</dict>
	</dict>
	<key>today.category.tile.a11y.value</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$d af %2$#@goals@</string>
		<key>goals</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d mål fuldført</string>
			<key>other</key>
			<string>%2$d mål fuldført</string>
		</dict>
	</dict>
	<key>a11y.stats.tier.row.format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d dag</string>
			<key>other</key>
			<string>%2$d dage</string>
		</dict>
	</dict>
	<key>a11y.stats.activity.row.format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@, %2$#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d dag</string>
			<key>other</key>
			<string>%2$d dage</string>
		</dict>
	</dict>
	<key>a11y.watch.recent.summary.format</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@: %2$#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d dag med præstation ud af 7.</string>
			<key>other</key>
			<string>%2$d dage med præstationer ud af 7.</string>
		</dict>
	</dict>
</dict>
</plist>
